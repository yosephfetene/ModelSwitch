# Copy to .env for local development. Never commit .env.
# Production injects these from a secret manager instead.

# Also used by `cargo test`: the role needs CREATEDB so #[sqlx::test]
# can create a throwaway database per test.
DATABASE_URL=postgres://modelswitch:CHANGE_ME@localhost:5432/modelswitch_dev

# Optional: provider API keys, read through `api_key_env` in
# modelswitch.toml. Groq keys come from https://console.groq.com/keys.
# GROQ_API_KEY=
# Gemini keys come from https://aistudio.google.com/apikey.
# GEMINI_API_KEY=

# Optional: log level (error, warn, info, debug, trace).
# RUST_LOG=info
